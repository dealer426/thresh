{
  "name": "ubuntu-python",
  "description": "Ubuntu with Python development tools",
  "base": "ubuntu-22.04",
  "packages": [
    "python3",
    "python3-pip",
    "python3-venv",
    "git",
    "curl",
    "vim"
  ],
  "scripts": {
    "setup": "# Create workspace\nmkdir -p /workspace\n",
    "postInstall": "# Clean up\napt-get clean\napt-get autoremove -y\n\n# Show Python version\npython3 --version\npip3 --version\n\necho \"Ubuntu Python environment ready!\"\n"
  },
  "environment": {
    "PYTHONUNBUFFERED": "1",
    "WORKSPACE": "/workspace"
  }
}
