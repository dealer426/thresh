# vCenter Connection Configuration
# Copy this file to .env and fill in your actual vCenter credentials
# NEVER commit .env to git!

VSPHERE_SERVER=vcenter.thresh.sh
VSPHERE_USER=administrator@vsphere.local
VSPHERE_PASSWORD=your-password-here

# vCenter Infrastructure Details
VSPHERE_DATACENTER=thresh
VSPHERE_CLUSTER=thresh-cluster
VSPHERE_DATASTORE=datastore1
VSPHERE_NETWORK=VM Network
VSPHERE_RESOURCE_POOL=Resources

# VM Configuration
VM_NAME=thresh-ubuntu-test
VM_CPUS=4
VM_MEMORY_MB=8192
VM_DISK_GB=60

# Templates (build with Packer - see packer/README.md)
UBUNTU_TEMPLATE=packer-ubuntu-22.04
WINDOWS_TEMPLATE=packer-windows-2022

# SSH Configuration
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub

# Test VM Settings
DEPLOY_WINDOWS=false
