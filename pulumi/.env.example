# vCenter Connection Configuration
# Copy this file to .env and fill in your actual vCenter credentials
# NEVER commit .env to git!

VSPHERE_SERVER=vcenter.thresh.sh
VSPHERE_USER=administrator@vsphere.local
VSPHERE_PASSWORD=your-password-here

# vCenter Infrastructure Details
VSPHERE_DATACENTER=thresh
VSPHERE_CLUSTER=thresh-cluster
VSPHERE_DATASTORE=datastore1
VSPHERE_NETWORK=VM Network
VSPHERE_RESOURCE_POOL=Resources

# VM Configuration
VM_NAME=thresh-ubuntu-test
VM_CPUS=4
VM_MEMORY_MB=8192
VM_DISK_GB=60

# Templates (build with Packer - see packer/README.md)
UBUNTU_TEMPLATE=packer-ubuntu-22.04
WINDOWS_TEMPLATE=packer-windows-2022

# SSH Configuration
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub

# Thresh Hub Configuration (for multi-node deployment)
# Get the API key from: https://localhost:7002 → API Keys page
# Hub URL should be the IP where your hub is running (accessible from VMs)
# Use actual host IP, not localhost (e.g., 192.168.4.85, not 127.0.0.1)
THRESH_HUB_URL=https://192.168.4.85:7002
THRESH_API_KEY=thresh_live_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Thresh GitHub Repository (default: sburnett-blg/thresh)
# Change this if using a fork or different repo
THRESH_GITHUB_REPO=https://github.com/sburnett-blg/thresh.git

# Test VM Settings
DEPLOY_WINDOWS=false
