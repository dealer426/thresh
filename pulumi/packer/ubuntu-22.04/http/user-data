#cloud-config
autoinstall:
  version: 1
  early-commands:
    - sudo systemctl stop ssh
  locale: en_US
  keyboard:
    layout: en
    variant: us
  packages: [open-vm-tools, openssh-server, net-tools, network-manager, perl, curl, vim, zip, unzip, cloud-init]
  network:
    network:
      version: 2
      ethernets:
        ens160:
          dhcp4: true
  identity:
    hostname: ubuntu-template
    username: thresh
    password: $6$rounds=4096$saltsalt$Lp/FV.2oOgew7GbM7ko.zgDFgQdYwu.lQCWaKsh4eXN7HVDuupd4w0xu3QJK5vyT4wLaNRZfK4Xw7qJp8mqZN.
  ssh:
    install-server: yes
    allow-pw: yes
  storage:
    layout:
      name: direct
  user-data:
    disable_root: false
  late-commands:
    - echo 'thresh ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/thresh
    - curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/thresh
